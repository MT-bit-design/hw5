{
  "server": "campus-customs (.mcp.json, stdio)",
  "database": "data/campus_customs_new.db",
  "user_prompt": "Problem 4: test all three tools by really calling them through the MCP connection, then check each output against data/campus_customs_new.db with a plain SQL query.",
  "all_tools_match_db": true,
  "results": [
    {
      "ticket": 101,
      "prompt": "Ticket 101: Is the Classic Bulldog Tee (CC-TEE-WHITE) in size S in stock, and what does it cost?",
      "tool": "mcp__campus-customs__check_stock",
      "arguments": {
        "sku": "CC-TEE-WHITE",
        "size": "S"
      },
      "tool_output": {
        "found": true,
        "sku": "CC-TEE-WHITE",
        "name": "Classic Bulldog Tee",
        "size": "S",
        "qty_on_hand": 0,
        "in_stock": false,
        "location": "Aisle B",
        "list_price": 28,
        "unit_cost": 8,
        "other_sizes": {
          "L": 3,
          "M": 5,
          "XL": 2
        }
      },
      "sql_check": {
        "queries": [
          "SELECT i.name, i.qty, i.location, p.list_price, p.unit_cost FROM inventory i JOIN pricing p USING (sku) WHERE i.sku='CC-TEE-WHITE' AND i.size='S'",
          "SELECT size, qty FROM inventory WHERE sku='CC-TEE-WHITE' AND size<>'S'"
        ],
        "fields_matched": {
          "name": true,
          "qty_on_hand": true,
          "in_stock": true,
          "location": true,
          "list_price": true,
          "unit_cost": true,
          "other_sizes": true
        },
        "all_match": true
      }
    },
    {
      "ticket": 102,
      "prompt": "Ticket 102: The landlord says rent is due in 2 days. What do we owe, when, and do we have the cash?",
      "tool": "mcp__campus-customs__get_bills_and_cash",
      "arguments": {},
      "tool_output": {
        "date_today": "2026-08-31",
        "leases": [
          {
            "id": 1,
            "space_name": "Chapel Street shop",
            "landlord": "Elm City Properties",
            "monthly_rent": 2400,
            "next_due": "2026-09-02",
            "days_until_due": 2
          }
        ],
        "unpaid_invoices": [
          {
            "id": 501,
            "vendor_id": 1,
            "vendor": "Bulldog Print Co",
            "amount": 840,
            "due_date": "2026-08-28",
            "status": "open",
            "description": "Rush reprint CC-TEE-WHITE S",
            "days_until_due": -3,
            "overdue": true
          }
        ],
        "cash_accounts": [
          {
            "name": "checking",
            "balance": 3400,
            "date": "2026-08-31"
          }
        ],
        "total_cash": 3400,
        "total_due": 3240,
        "cash_after_paying_all": 160
      },
      "sql_check": {
        "queries": [
          "SELECT l.monthly_rent, l.next_due, CAST(julianday(l.next_due) - julianday(d.date_today) AS INT) FROM leases l, desk d WHERE l.id=1",
          "SELECT i.amount, i.due_date, i.status, v.name, CAST(julianday(i.due_date) - julianday(d.date_today) AS INT) FROM invoices i JOIN vendors v ON v.id=i.vendor_id, desk d WHERE i.id=501",
          "SELECT (SELECT SUM(balance) FROM cash_accounts), (SELECT SUM(monthly_rent) FROM leases) + (SELECT SUM(amount) FROM invoices WHERE status<>'paid'), (SELECT date_today FROM desk)"
        ],
        "fields_matched": {
          "date_today": true,
          "rent": true,
          "rent_due": true,
          "rent_days_until_due": true,
          "invoice_amount": true,
          "invoice_due": true,
          "invoice_status": true,
          "invoice_vendor": true,
          "invoice_days_until_due": true,
          "invoice_overdue": true,
          "total_cash": true,
          "total_due": true,
          "cash_after_paying_all": true
        },
        "all_match": true
      }
    },
    {
