      "sql_check": {
        "queries": [
          "SELECT i.qty, MAX(20 - i.qty, 0), p.list_price, p.unit_cost, p.list_price*20, p.unit_cost*20, ROUND((1 - p.unit_cost/p.list_price)*100, 1) FROM inventory i JOIN pricing p USING (sku) WHERE i.sku='CC-HOOD-NAVY' AND i.size='M'",
          "SELECT id, name, specialty, lead_days FROM vendors ORDER BY lead_days"
